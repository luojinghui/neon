# Keep the real file outside Git and readable only by the deployment user.
MONGODB_URI='mongodb://USER:URL_ENCODED_PASSWORD@127.0.0.1:27017/DATABASE?authSource=admin'
APP_HOST=127.0.0.1
APP_PORT=3000
# Optional: IPs/CIDRs of proxies trusted by cloud network diagnostics (empty = direct peer only).
# For same-machine Nginx that overwrites X-Forwarded-For, use 'loopback'. Never use an arbitrary hop count.
CLOUD_TRUSTED_PROXIES=''
# Optional. Defaults to upload/cloud-plaza; keep outside release directories in production.
CLOUD_PLAZA_UPLOAD_DIRECTORY='upload/cloud-plaza'
# Optional, comma-separated origins for cross-origin Socket.IO clients.
ALLOWED_ORIGINS='https://example.com'
# WebRTC: production/mobile calls require HTTPS and a reachable TURN relay.
# Comma-separated URLs; TURN_SECRET is coturn's static-auth-secret, never NEXT_PUBLIC.
# Same default as cloud diagnostics. This endpoint provides STUN only, not TURN.
WEBRTC_STUN_URLS='stun:8.137.55.241:3478'
WEBRTC_TURN_URLS=''
WEBRTC_TURN_SECRET=''
WEBRTC_RELAY_ONLY=false
# Optional LibreOffice executable or isolated conversion wrapper for PPT/PPTX sharing.
# Auto-detected at /usr/bin/libreoffice or the standard Windows install location.
CALL_SHARE_OFFICE_PATH=''
# Optional. Defaults to .data/soul-chat.json and stores rooms/messages across restarts.
SOUL_CHAT_DATA_FILE='.data/soul-chat.json'
# Optional. Defaults to .data/user-profiles.json and stores browser-bound user profiles across restarts.
USER_PROFILE_DATA_FILE='.data/user-profiles.json'
# Optional. Keep these paths outside release directories in production.
DOODLE_REVIEW_DATA_FILE='.data/doodle-reviews.json'
DOODLE_REVIEW_UPLOAD_DIRECTORY='.data/doodle-review-images'
DOODLE_SHARE_DATA_FILE='.data/doodle-shares.json'
DOODLE_UPLOAD_DIRECTORY='public/uploads/doodle'
# Optional. Keep the moment index and uploaded media outside release directories in production.
MOMENT_DATA_FILE='.data/moments.json'
MOMENT_UPLOAD_DIRECTORY='public/uploads/moments'
# MCP HTTP: 配置访问令牌后启用 /mcp，未配置则保持关闭。
# 使用随机生成的 32 字节十六进制令牌；不能与云传查看密码混用。
MCP_AUTH_TOKEN=''
# 发布结果中的网站根地址，启用 MCP 时必须配置；反向代理需保留 Host。
MCP_PUBLIC_BASE_URL='http://127.0.0.1:3000'
# 心迹发布所使用的已有个人资料 UUID；留空时其他三个工具仍可使用。
MCP_OWNER_UUID=''
